{
  "name": "Godot C# DevContainer",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "containerEnv": {
    "DOTNET_ROOT": "/usr/lib64/dotnet",
    "DOTNET_SYSTEM_GLOBALIZATION_INVARIANT": "0"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "geequlim.godot-tools",
        "EditorConfig.EditorConfig"
      ],
      "settings": {
        "dotnet.defaultSolution": "src/*.sln*",
        // 🔥 force stable mode
        "dotnet.server.useOmnisharp": true,
        // ❗ prevents automatic runtime downloads
        "dotnet.acquireRuntime.enable": false,
        // quality of life
        "editor.formatOnSave": true,
        "files.exclude": {
          "**/.git": false
        },
        "editor.codeActionsOnSave": {
          "source.fixAll": "always",
          "source.organizeImports": "always"
        },
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.autoReveal": true,
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash"
          }
        }
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/run_post_create.sh",
  "remoteUser": "root"
}